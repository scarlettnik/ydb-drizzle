{
  "name": "ydb-drizzle-adapter",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --import tsx --test tests/live/*.test.ts",
    "test:live": "node --import tsx --test tests/live/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:migrations": "node --import tsx --test tests/unit/migration*.test.ts tests/live/migrations.test.ts",
    "test:query-builders": "node --import tsx --test tests/unit/select-builder*.test.ts tests/unit/query-builder-utils.test.ts tests/unit/mutation-builders.test.ts tests/unit/builder-contract.test.ts tests/unit/relational-query.test.ts tests/live/select-features.test.ts",
    "test:all": "node --import tsx --test tests/unit/*.test.ts tests/live/*.test.ts",
    "test:smoke": "node --import tsx tests/live/test-connection.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@yandex-cloud/nodejs-sdk": "^2.9.0",
    "@ydbjs/core": "^6.0.7",
    "@ydbjs/query": "^6.0.7",
    "@ydbjs/value": "^6.0.5",
    "drizzle-orm": "^0.45.1",
    "ydb-sdk": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
